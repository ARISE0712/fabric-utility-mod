{
  "schemaVersion": 1,
  "id": "fabricutility",
  "version": "${version}",
  "name": "Fabric Utility Mod",
  "description": "A utility mod with Flight and ESP features",
  "authors": [
    "ARISE"
  ],
  "contact": {
    "homepage": "https://github.com/ARISE0712/fabric-utility-mod",
    "sources": "https://github.com/ARISE0712/fabric-utility-mod"
  },
  "license": "MIT",
  "icon": "assets/fabricutility/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.arise.fabricutility.FabricUtilityClient"
    ]
  },
  "mixins": [
    "fabricutility.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": "*",
    "minecraft": "~1.21.10",
    "java": ">=21"
  },
  "suggests": {
    "another-mod": "*"
  }
}
